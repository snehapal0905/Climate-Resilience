{
  "name": "climate-resilience-platform",
  "private": true,
  "version": "0.1.0",
  "description": "AI-driven climate resilience and action platform — flood early warning for Assam",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "infra:up": "docker compose up -d db redis ml",
    "infra:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @climate/api",
    "db:seed": "npm run db:seed -w @climate/api",
    "pipeline:live": "npm run pipeline -w @climate/api -- --mode live",
    "pipeline:replay": "npm run pipeline -w @climate/api -- --mode replay --date 2022-06-14",
    "dev:api": "npm run dev -w @climate/api",
    "dev:web": "npm run dev -w @climate/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
